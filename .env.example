# LOCAL mode (LocalStack). Copy to .env (git-ignored). Never commit .env.
#   docker compose up -d
#   uv run --env-file .env generate.py --month 2026-10

# Starts the LocalStack container (see docker-compose.yml).
COMPOSE_PROFILES=localstack

# --- AWS (fake) ----------------------------------------------------------
# LocalStack accepts any credentials.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-central-1
# Read natively by boto3. Works both from your laptop and inside docker
# (see the network alias in docker-compose.yml).
AWS_ENDPOINT_URL=http://localhost.localstack.cloud:4566

S3_BUCKET=savehub-bank-files

# --- LocalStack ----------------------------------------------------------
# Free non-commercial "Hobby" token: https://app.localstack.cloud -> Auth Tokens
LOCALSTACK_AUTH_TOKEN=
