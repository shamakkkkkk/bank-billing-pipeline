# LOCAL mode (LocalStack). Copy to .env (git-ignored). Never commit .env.
#   docker compose up -d
#   uv run --env-file .env generate.py --month 2026-10

# Starts the LocalStack container (see docker-compose.yml).
COMPOSE_PROFILES=localstack

# --- AWS (fake) ----------------------------------------------------------
# LocalStack accepts any credentials.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-central-1
# Read natively by boto3. Works both from your laptop and inside docker
# (see the network alias in docker-compose.yml).
AWS_ENDPOINT_URL=http://localhost.localstack.cloud:4566

S3_BUCKET=savehub-bank-files

# --- LocalStack ----------------------------------------------------------
# Free non-commercial "Hobby" token: https://app.localstack.cloud -> Auth Tokens
LOCALSTACK_AUTH_TOKEN=

# --- Warehouse ------------------------------------------------------------
# duckdb (default, local file data/warehouse.duckdb) or snowflake
WAREHOUSE=duckdb

# Snowflake (only read when WAREHOUSE=snowflake, or by pytest -m snowflake).
# One-time setup: scripts/snowflake_setup.sh, then run secrets/snowflake_setup.sql
# in a Snowsight worksheet. Account identifier: Snowsight -> your name (bottom
# left) -> Account -> "Copy account identifier", written with a dash: ORG-ACCOUNT
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SAVEHUB_PIPELINE
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/snowflake_key.p8
SNOWFLAKE_ROLE=SAVEHUB_PIPELINE
SNOWFLAKE_WAREHOUSE=SAVEHUB_WH
SNOWFLAKE_DATABASE=SAVEHUB
SNOWFLAKE_SCHEMA=BILLING
