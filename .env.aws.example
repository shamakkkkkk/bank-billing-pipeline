# REAL AWS mode. Copy to .env.aws (git-ignored). Never commit .env.aws.
#   docker compose --env-file .env.aws up -d
#   uv run --env-file .env.aws generate.py --month 2026-10
#
# Same variables as .env, minus AWS_ENDPOINT_URL and the LocalStack profile:
# without an endpoint, boto3 talks to real AWS. No code changes.

# Tells docker compose to give Airflow this file instead of .env.
SAVEHUB_ENV_FILE=.env.aws

# Keys of the IAM user "savehub-dev" (NOT the root account).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# S3 bucket names are globally unique: add your own suffix.
S3_BUCKET=savehub-bank-files-CHANGE-ME
